  "GHSA-pc63-qcmh-9cmg": {
   "id": "GHSA-pc63-qcmh-9cmg",
   "summary": "Spring Framework Improper Path Limitation in XsltView",
   "details": "Use of XsltView in a Spring MVC application can result in SSRF and RCE attack if the application has an \"/**\" mapping that results in view rendering, and where the view name is not explicitly specified.\nSpring Framework 7.0.0 - 7.0.8\nSpring Framework 6.2.0 - 6.2.19\nSpring Framework 6.1.0 - 6.1.28\nSpring Framework 6.0.0 - 6.0.30\nSpring Framework 5.3.0 - 5.3.49\nSpring Framework 5.2.25.RELEASE and earlier",
   "aliases": [
    "CVE-2026-47884"
